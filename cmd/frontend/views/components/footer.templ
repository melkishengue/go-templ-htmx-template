package components

templ Footer() {
	<footer class="bg-gradient-to-br from-slate-900 via-indigo-950 to-slate-900 text-white">
		<!-- Main Footer Content -->
		<div class="container mx-auto px-6 py-16">
			<div class="grid md:grid-cols-12 gap-12 mb-12">
				<!-- Brand Section -->
				<div class="md:col-span-5">
					<a href="/" class="flex items-center space-x-3 mb-6 group">
						<div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center shadow-lg shadow-indigo-500/50 group-hover:shadow-indigo-500/80 transition-all duration-300">
							<img width="32" height="32" src="https://img.icons8.com/fluency/96/windows-defender.png" alt="MyApp API Logo" class="drop-shadow-lg"/>
						</div>
						<span class="text-3xl font-bold bg-gradient-to-r from-indigo-400 to-purple-400 bg-clip-text text-transparent">MyApp</span>
					</a>
					<p class="text-slate-300 mb-8 text-lg leading-relaxed max-w-md">
						Beautifully crafted components built with HTMX, templ, Tailwind & PostgreSQL. The perfect starting point for modern web applications.
					</p>
					<!-- Social Links -->
					<div class="flex space-x-3">
						<a href="#" class="group relative w-11 h-11 bg-white/10 backdrop-blur-sm border border-white/20 rounded-xl flex items-center justify-center text-slate-300 hover:bg-indigo-500 hover:border-indigo-400 transition-all duration-300 hover:scale-110 hover:shadow-lg hover:shadow-indigo-500/50">
							<i class="fab fa-twitter text-lg"></i>
						</a>
						<a href="#" class="group relative w-11 h-11 bg-white/10 backdrop-blur-sm border border-white/20 rounded-xl flex items-center justify-center text-slate-300 hover:bg-indigo-500 hover:border-indigo-400 transition-all duration-300 hover:scale-110 hover:shadow-lg hover:shadow-indigo-500/50">
							<i class="fab fa-github text-lg"></i>
						</a>
						<a href="#" class="group relative w-11 h-11 bg-white/10 backdrop-blur-sm border border-white/20 rounded-xl flex items-center justify-center text-slate-300 hover:bg-indigo-500 hover:border-indigo-400 transition-all duration-300 hover:scale-110 hover:shadow-lg hover:shadow-indigo-500/50">
							<i class="fab fa-linkedin text-lg"></i>
						</a>
					</div>
				</div>
				<!-- Quick Links -->
				<div class="md:col-span-2 md:col-start-7">
					<h4 class="font-bold text-white text-lg mb-6 relative inline-block">
						Quick Links
						<span class="absolute -bottom-2 left-0 w-12 h-1 bg-gradient-to-r from-indigo-500 to-purple-500 rounded-full"></span>
					</h4>
					<ul class="space-y-3">
						<li>
							<a href="/" class="text-slate-300 hover:text-indigo-400 transition-colors duration-200 flex items-center group">
								<span class="w-1.5 h-1.5 bg-indigo-500 rounded-full mr-3 group-hover:w-6 transition-all duration-300"></span>
								Home
							</a>
						</li>
						<li>
							<a href="/docs" class="text-slate-300 hover:text-indigo-400 transition-colors duration-200 flex items-center group">
								<span class="w-1.5 h-1.5 bg-indigo-500 rounded-full mr-3 group-hover:w-6 transition-all duration-300"></span>
								Documentation
							</a>
						</li>
						<li>
							<a href="/api" class="text-slate-300 hover:text-indigo-400 transition-colors duration-200 flex items-center group">
								<span class="w-1.5 h-1.5 bg-indigo-500 rounded-full mr-3 group-hover:w-6 transition-all duration-300"></span>
								API Reference
							</a>
						</li>
					</ul>
				</div>
				<!-- Support -->
				<div class="md:col-span-2">
					<h4 class="font-bold text-white text-lg mb-6 relative inline-block">
						Support
						<span class="absolute -bottom-2 left-0 w-12 h-1 bg-gradient-to-r from-indigo-500 to-purple-500 rounded-full"></span>
					</h4>
					<ul class="space-y-3">
						<li>
							<a href="/contact" class="text-slate-300 hover:text-indigo-400 transition-colors duration-200 flex items-center group">
								<span class="w-1.5 h-1.5 bg-indigo-500 rounded-full mr-3 group-hover:w-6 transition-all duration-300"></span>
								Contact Us
							</a>
						</li>
						<li>
							<a href="/faq" class="text-slate-300 hover:text-indigo-400 transition-colors duration-200 flex items-center group">
								<span class="w-1.5 h-1.5 bg-indigo-500 rounded-full mr-3 group-hover:w-6 transition-all duration-300"></span>
								FAQ
							</a>
						</li>
						<li>
							<a href="/help" class="text-slate-300 hover:text-indigo-400 transition-colors duration-200 flex items-center group">
								<span class="w-1.5 h-1.5 bg-indigo-500 rounded-full mr-3 group-hover:w-6 transition-all duration-300"></span>
								Help Center
							</a>
						</li>
					</ul>
				</div>
				<!-- Resources -->
				<div class="md:col-span-3">
					<h4 class="font-bold text-white text-lg mb-6 relative inline-block">
						Resources
						<span class="absolute -bottom-2 left-0 w-12 h-1 bg-gradient-to-r from-indigo-500 to-purple-500 rounded-full"></span>
					</h4>
					<ul class="space-y-3">
						<li>
							<a href="/blog" class="text-slate-300 hover:text-indigo-400 transition-colors duration-200 flex items-center group">
								<span class="w-1.5 h-1.5 bg-indigo-500 rounded-full mr-3 group-hover:w-6 transition-all duration-300"></span>
								Blog
							</a>
						</li>
						<li>
							<a href="/changelog" class="text-slate-300 hover:text-indigo-400 transition-colors duration-200 flex items-center group">
								<span class="w-1.5 h-1.5 bg-indigo-500 rounded-full mr-3 group-hover:w-6 transition-all duration-300"></span>
								Changelog
							</a>
						</li>
						<li>
							<a href="/community" class="text-slate-300 hover:text-indigo-400 transition-colors duration-200 flex items-center group">
								<span class="w-1.5 h-1.5 bg-indigo-500 rounded-full mr-3 group-hover:w-6 transition-all duration-300"></span>
								Community
							</a>
						</li>
					</ul>
				</div>
			</div>
		</div>
		<!-- Bottom Bar -->
		<div class="border-t border-white/10 backdrop-blur-sm">
			<div class="container mx-auto px-6 py-6">
				<div class="flex flex-col md:flex-row justify-between items-center gap-4">
					<p class="text-slate-400 text-sm flex items-center gap-2">
						© 2025 MyApp.dev. All rights reserved.
						<span class="hidden md:inline text-slate-600">|</span>
						<span class="text-slate-500">Built with ❤️ for developers</span>
					</p>
					<div class="flex flex-wrap justify-center gap-6">
						<a href="/privacy" class="text-slate-400 hover:text-indigo-400 text-sm transition-colors duration-200">Privacy Policy</a>
						<a href="/terms" class="text-slate-400 hover:text-indigo-400 text-sm transition-colors duration-200">Terms of Service</a>
						<a href="/cookies" class="text-slate-400 hover:text-indigo-400 text-sm transition-colors duration-200">Cookie Policy</a>
					</div>
				</div>
			</div>
		</div>
	</footer>
}
